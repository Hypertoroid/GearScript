// A pendulum: one hinge, two motion blocks, and an arrow for gravity.
Pivot::Box  { size: (40mm, 20mm, 60mm); at: (0, 400mm, 0); }
Arm::Box    { size: (6mm, 300mm, 8mm); hinge: edge.top on Pivot.edge.bottom; range: -45deg..45deg; }
Bob::Sphere { radius: 30mm; attach: Arm.face.bottom; }

Gravity::Arrow { from: (150mm, 260mm, 0); to: (150mm, 160mm, 0); stroke: 4mm; }

// sounds: generated by GearScript, free to use
Tick::Sound { kind: tick; }
Tock::Sound { kind: tock; }

Observer { position: (0, 260mm, 900mm); look-at: (0, 240mm, 0); }
Light { kind: directional; direction: (-0.4, -1, -0.8); power: 0.9; }
Scene { duration: 2.4s; }
