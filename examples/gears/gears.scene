// A crank turns G1. G2 and G3 follow through gear mesh.
G1::Gear.gear { teeth: 36; module: 2mm; width: 10mm; at: (0, 0, 0); }
G2::Gear.gear { teeth: 12; module: 2mm; width: 10mm; mesh: G1; }           // placed by the mesh
G3::Gear.gear { teeth: 18; module: 2mm; width: 10mm; mesh: G2 at 60deg; }  // placed above G2

Crank::Rod     { length: 50mm; radius: 2.5mm; attach: end.a to G1.face.front; }
Knob::Cylinder { radius: 4mm; height: 14mm; orient: 90deg about x; attach: face.bottom to Crank.end.b; }

// sounds: generated by GearScript, free to use
Mesh::Sound { kind: gear; length: 6s; volume: 35%; }

Observer { position: (30mm, -45mm, 210mm); look-at: (34mm, 8mm, 0); }
Light { kind: directional; direction: (-0.6, -1, -1.4); power: 0.9; }
