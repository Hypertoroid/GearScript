Scene { sound: Chime at 94.8s; }   // the moment it is wound

Aim {
    0s..11.5s: move: (0, 30mm, 0) -> (0, 20mm, 0) ease-in-out;
    11.5s..14s: move: (0, 20mm, 0) -> (0, 330mm, 0) ease-in-out;
    14s..21.5s: move: (0, 330mm, 0) -> (0, 330mm, 0) ease-in-out;
    21.5s..24s: move: (0, 330mm, 0) -> (0, 330mm, 0) ease-in-out;
    24s..45s: move: (0, 330mm, 0) -> (0, 350mm, 0) ease-in-out;
    45s..47.5s: move: (0, 350mm, 0) -> (0, 420mm, 0) ease-in-out;
    47.5s..55s: move: (0, 420mm, 0) -> (0, 390mm, 0) ease-in-out;
    55s..57.5s: move: (0, 390mm, 0) -> (0, 330mm, 30mm) ease-in-out;
    57.5s..73.5s: move: (0, 330mm, 30mm) -> (0, 330mm, 30mm) ease-in-out;
    73.5s..76.5s: move: (0, 330mm, 30mm) -> (0, 60mm, 0) ease-in-out;
    76.5s..85.5s: move: (0, 60mm, 0) -> (0, 20mm, 0) ease-in-out;
    85.5s..88s: move: (0, 20mm, 0) -> (0, -60mm, 0) ease-in-out;
    88s..92.5s: move: (0, -60mm, 0) -> (0, -20mm, 0) ease-in-out;
    92.5s..95s: move: (0, -20mm, 0) -> (0, 330mm, 40mm) ease-in-out;
    95s..99.5s: move: (0, 330mm, 40mm) -> (0, 330mm, 40mm) ease-in-out;
    99.5s..110s: move: (0, 330mm, 40mm) -> (0, 205mm, 0) ease-in-out;
}

Observer {
    forever: look-at: Aim;
    0s..11.5s: position: (900mm, 250mm, 2900mm) -> (700mm, 120mm, 2550mm) ease-in-out;
    11.5s..14s: position: (700mm, 120mm, 2550mm) -> (360mm, 470mm, 700mm) ease-in-out;
    14s..21.5s: position: (360mm, 470mm, 700mm) -> (260mm, 420mm, 600mm) ease-in-out;
    21.5s..24s: position: (260mm, 420mm, 600mm) -> (240mm, 330mm, 520mm) ease-in-out;
    24s..45s: position: (240mm, 330mm, 520mm) -> (-230mm, 380mm, 520mm) ease-in-out;
    45s..47.5s: position: (-230mm, 380mm, 520mm) -> (170mm, 560mm, 440mm) ease-in-out;
    47.5s..55s: position: (170mm, 560mm, 440mm) -> (120mm, 470mm, 520mm) ease-in-out;
    55s..57.5s: position: (120mm, 470mm, 520mm) -> (40mm, 330mm, 700mm) ease-in-out;
    57.5s..73.5s: position: (40mm, 330mm, 700mm) -> (-70mm, 300mm, 560mm) ease-in-out;
    73.5s..76.5s: position: (-70mm, 300mm, 560mm) -> (700mm, 200mm, 2700mm) ease-in-out;
    76.5s..85.5s: position: (700mm, 200mm, 2700mm) -> (520mm, 100mm, 2450mm) ease-in-out;
    85.5s..88s: position: (520mm, 100mm, 2450mm) -> (-620mm, -40mm, 1800mm) ease-in-out;
    88s..92.5s: position: (-620mm, -40mm, 1800mm) -> (-520mm, 0, 1650mm) ease-in-out;
    92.5s..95s: position: (-520mm, 0, 1650mm) -> (0, 330mm, 760mm) ease-in-out;
    95s..99.5s: position: (0, 330mm, 760mm) -> (0, 330mm, 760mm) ease-in-out;
    99.5s..110s: position: (0, 330mm, 760mm) -> (480mm, 330mm, 1950mm) ease-in-out;
}
