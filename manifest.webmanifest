{
  "id": "./studio.html",
  "name": "GearScript Studio",
  "short_name": "GearScript",
  "description": "Describe parts and how they connect; GearScript solves the motion. Works offline once installed.",
  "start_url": "studio.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1216",
  "theme_color": "#0f1216",
  "categories": [
    "education",
    "graphics",
    "productivity"
  ],
  "icons": [
    {
      "src": "brand/app-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "brand/app-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "brand/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./studio.html",
      "accept": {
        "text/plain": [
          ".gscript"
        ],
        "application/zip": [
          ".zip"
        ]
      },
      "icons": [
        {
          "src": "brand/app-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
