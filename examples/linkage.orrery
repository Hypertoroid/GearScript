@orrery 1

@scene
// A crank-rocker four-bar linkage. Only the crank is driven:
// the pin closes the loop, and the coupler and rocker follow.
let crank = 40mm;

Base::Box { size: (170mm, 12mm, 10mm); at: (55mm, -34mm, -16mm); }
Post1::Box.post { size: (12mm, 34mm, 10mm); align: face.bottom; at: Base.face.top + (-55mm, 0, 0); }
Post2::Box.post { size: (12mm, 34mm, 10mm); align: face.bottom; at: Base.face.top + (55mm, 0, 0); }

Crank::Link   { length: crank; width: 14mm; hinge: end.a on (0, 0, 0); }
Coupler::Link { length: 120mm; width: 14mm; hinge: end.a on Crank.end.b + (0, 0, 6mm);
                anchor tip: (10mm, 46mm, 0); pin: end.b to Rocker.end.b; }
Rocker::Link  { length: 90mm; width: 14mm; orient: 90deg about z; hinge: end.a on (110mm, 0, 0); }
Pen::Sphere   { radius: 5mm; attach: Coupler.tip; }

Observer { position: (60mm, 70mm, 420mm); look-at: (60mm, 60mm, 0); }
Light { kind: directional; direction: (-0.4, -0.8, -1); power: 0.85; }
Scene { duration: 4s; }

@style
Base, .post { color: #3b4148; material: matte; }
Crank       { color: #b8442e; material: plastic; label: "crank (driven)"; }
Coupler     { color: #e0a63a; material: plastic; }
Rocker      { color: #2f6f8f; material: plastic; label: "rocker"; }
Pen         { color: #f2efe6; trail: #c2410c; }      // the coupler curve

@motion
// One motion rule. The solver keeps the pin together at every frame.
Crank { forever: rotate: 180deg/s; }
