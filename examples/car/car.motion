// A change between two speeds is an acceleration. Units decide: mm/s is a speed.
let cruise = (600mm/s, 0, 0);

Car {
    0s..1.5s: move: (0, 0, 0) -> cruise ease-in;     // pull away
    then:     move: cruise;                          // cruise for 1.5 s
    3s..4.2s: move: cruise -> (0, 0, 0) ease-out;    // brake to a stop
}

// Every Tyre rolls: the spin always matches the car, even while it speeds up and slows down.
Tyre { forever: roll: Road; }

Observer { forever: follow: Car offset (380mm, 260mm, 1150mm); }

Scene { sound: Motor; }
Car { 3s..4.2s: sound: Brake; }
