@gearscript 1

@scene
// A slider: the piston moves along the barrel's axis.
Barrel::Cylinder { radius: 40mm; height: 280mm; orient: 90deg about z; at: (0, 60mm, 0); }
Piston::Cylinder { radius: 36mm; height: 50mm; slider: axis on Barrel.axis; range: -110mm..110mm; }
Stem::Rod        { length: 220mm; radius: 7mm; attach: end.b to Piston.face.bottom; }

// sounds: generated by GearScript, free to use
Stop::Sound { kind: clank; pitch: 120%; volume: 50%; }

Observer { position: (40mm, 230mm, 560mm); look-at: (60mm, 50mm, 0); }
Light { kind: directional; direction: (-0.4, -1, -0.8); power: 0.9; }
Scene { grid: floor; }

@style
Barrel { color: glass; material: glass; outline: 1px #5d8a96; }
Piston { color: steel; material: metal; outline: 1px #2b3138; }
Stem   { color: #b8442e; }

@motion
Piston {
    0s..1.2s: move: -90mm -> 90mm ease-in-out;
    then:     move: 90mm -> -90mm ease-in-out;
}

Piston { 0s..1.2s: sound: Stop at end; then: sound: Stop at end; }    // at each end of the stroke
