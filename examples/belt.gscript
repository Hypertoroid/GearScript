@gearscript 1

@scene
// A small pulley drives a large one through a belt.
Motor::Pulley { radius: 30mm; width: 16mm; at: (0, 0, 0); }
Drum::Pulley  { radius: 60mm; width: 16mm; at: (200mm, 30mm, 0); belt: Motor; }   // half speed, same direction

Mark::Box { size: (6mm, 24mm, 3mm);   attach: face.bottom to Motor.face.front; }
Fan::Box  { size: (14mm, 130mm, 4mm); attach: Drum.face.front; }

// sounds: generated by GearScript, free to use
SpinUp::Sound { kind: servo; length: 1s; volume: 50%; }
Run::Sound    { kind: whirr; length: 3s; volume: 45%; }

Observer { position: (90mm, -30mm, 420mm); look-at: (100mm, 15mm, 0); }
Light { kind: directional; direction: (-0.5, -0.8, -1); power: 0.9; }
Scene { duration: 4s; }

@style
Pulley     { color: aluminium; material: metal; outline: 1px #2b3138; }
Motor      { label: "Motor"; }
Drum       { label: "Drum: half speed"; }
Mark, Fan  { color: #b8442e; material: plastic; }

@motion
// deg/s2 is an angular acceleration: the motor spins up for 1 s, then runs steadily.
Motor {
    0s..1s:  rotate: 360deg/s2;
    then 3s: rotate: 360deg/s;
}

Motor { 0s..1s: sound: SpinUp; 1s..4s: sound: Run; }
