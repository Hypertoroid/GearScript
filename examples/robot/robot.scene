// Humanoid robot walking in place on a treadmill (robot faces +x, its right side is +z)
// Gait: 1.2s per stride; the pelvis bobs but stays put, and the ground tiles slide backwards under the feet
// sounds: generated by Orrery, free to use
StepL::Sound { kind: footstep; volume: 70%; }
StepR::Sound { kind: footstep; pitch: 92%; volume: 70%; }
Belt::Sound  { kind: rumble; pitch: 160%; length: 60s; volume: 25%; }

Scene { duration: 60s; background: #070a10; grid: floor; }

let thigh = 90mm;
let shank = 90mm;
let upper = 62mm;
let fore = 58mm;
let hipzp = 38mm;
let hipzn = -38mm;
let shzp = 76mm;
let shzn = -76mm;

// Ground tiles, extra long so the treadmill loop never shows a gap
Tile::Box.tile { size: (140mm, 6mm, 320mm); at: (-600mm, -3mm, 0); repeat: 14 step (300mm, 0, 0); overlap: allow; }   // the toes brush the belt at the end of each swing

// Pelvis, torso, backpack, chest light
Pelvis::Box.body { size: (56mm, 40mm, 112mm); at: (0, 210mm, 0); }
Torso::Box.torso { size: (50mm, 120mm, 120mm); attach: face.bottom to Pelvis.face.top; }
Pack::Box.body { size: (30mm, 90mm, 90mm); attach: face.right to Torso.face.left; }
ChestCore::Sphere.core { radius: 12mm; attach: center to Torso.face.right; }

// Neck, head, visor, eyes, antenna
Neck::Rod.body { length: 14mm; radius: 9mm; attach: end.a to Torso.face.top; }
Head::Sphere.head { radius: 30mm; attach: pole.bottom to Neck.end.b; }
Visor::Box.visor { size: (14mm, 22mm, 46mm); attach: center to Head.center + (22mm, 2mm, 0); }
EyeL::Sphere.eye { radius: 4.5mm; attach: center to Head.center + (30mm, 2mm, -12mm); }
EyeR::Sphere.eye { radius: 4.5mm; attach: center to Head.center + (30mm, 2mm, 12mm); }
Antenna::Rod.body { length: 20mm; radius: 2mm; attach: end.a to Head.pole.top; }
Bulb::Sphere.eye { radius: 5mm; attach: center to Antenna.end.b; }

// Hip joints ride on the pelvis; the thighs hinge on them
HipL::Sphere.joint { radius: 15mm; attach: center to Pelvis.center + (0, -20mm, hipzn); }
HipR::Sphere.joint { radius: 15mm; attach: center to Pelvis.center + (0, -20mm, hipzp); }

// Legs: thigh at the hip, shank at the knee, foot at the ankle (each points down at rest)
ThighL::Link.leg { length: thigh; width: 24mm; thickness: 24mm; orient: 270deg about z; hinge: end.a on HipL.center; }
ShankL::Link.leg { length: shank; width: 20mm; thickness: 20mm; orient: 270deg about z; hinge: end.a on ThighL.end.b; }
FootL::Link.foot { length: 62mm; width: 20mm; thickness: 34mm; hinge: end.a on ShankL.end.b; }
ThighR::Link.leg { length: thigh; width: 24mm; thickness: 24mm; orient: 270deg about z; hinge: end.a on HipR.center; }
ShankR::Link.leg { length: shank; width: 20mm; thickness: 20mm; orient: 270deg about z; hinge: end.a on ThighR.end.b; }
FootR::Link.foot { length: 62mm; width: 20mm; thickness: 34mm; hinge: end.a on ShankR.end.b; }

KneeL::Sphere.joint { radius: 13mm; attach: center to ThighL.end.b; }
KneeR::Sphere.joint { radius: 13mm; attach: center to ThighR.end.b; }

// Shoulder joints ride on the torso; the upper arms hinge on them
ShoulderL::Sphere.joint { radius: 14mm; attach: center to Torso.center + (0, 44mm, shzn); }
ShoulderR::Sphere.joint { radius: 14mm; attach: center to Torso.center + (0, 44mm, shzp); }

// Arms: upper arm at the shoulder, forearm at the elbow, hand at the wrist
UpperL::Link.arm { length: upper; width: 18mm; thickness: 18mm; orient: 270deg about z; hinge: end.a on ShoulderL.center; }
ForeL::Link.arm { length: fore; width: 15mm; thickness: 15mm; orient: 270deg about z; hinge: end.a on UpperL.end.b; }
HandL::Link.hand { length: 30mm; width: 20mm; thickness: 12mm; orient: 270deg about z; hinge: end.a on ForeL.end.b; }
UpperR::Link.arm { length: upper; width: 18mm; thickness: 18mm; orient: 270deg about z; hinge: end.a on ShoulderR.center; }
ForeR::Link.arm { length: fore; width: 15mm; thickness: 15mm; orient: 270deg about z; hinge: end.a on UpperR.end.b; }
HandR::Link.hand { length: 30mm; width: 20mm; thickness: 12mm; orient: 270deg about z; hinge: end.a on ForeR.end.b; }

ElbowL::Sphere.joint { radius: 10mm; attach: center to UpperL.end.b; }
ElbowR::Sphere.joint { radius: 10mm; attach: center to UpperR.end.b; }
WristL::Sphere.joint { radius: 8mm; attach: center to ForeL.end.b; }
WristR::Sphere.joint { radius: 8mm; attach: center to ForeR.end.b; }

Observer { position: (380mm, 280mm, 850mm); look-at: Pelvis; }
Light { kind: directional; direction: (-1, -2, -1); power: 0.95; }