// A ball thrown on the Moon. A speed plus a constant acceleration makes a true arc.
let vx = 600mm/s;
let vy = 1200mm/s;
let g = -1.62m/s2;           // Moon gravity, slow enough to watch
let flight = 1.5s;

Ground::Box { size: (1400mm, 6mm, 300mm); at: (600mm, -3mm, 0); overlap: allow; }   // the ball comes to rest in it
Launcher::Group {
    overlap: allow;   // the ball starts inside the barrel
    base:   Box { size: (60mm, 20mm, 60mm); }
    barrel: Cylinder { radius: 9mm; height: 70mm; orient: -26.6deg about z; at: base.face.top + (12mm, 24mm, 0); }
    at: (0, 10mm, 0);
}
Ball::Sphere { radius: 12mm; at: (0, 30mm, 0); }

// The path the ball should follow, drawn from the same numbers.
Arc::Curve { domain: u in 0..1; point: (vx * u * flight, 30mm + vy * u * flight + 0.5 * g * (u * flight) * (u * flight), 0); stroke: 2mm; }
Gravity::Arrow { from: (1060mm, 470mm, 0); to: (1060mm, 340mm, 0); stroke: 5mm; }

// sounds: generated by Orrery, free to use
Land::Sound { kind: thud; }

Observer { position: (560mm, 640mm, 1750mm); look-at: (560mm, 200mm, 0); }
Light { kind: directional; direction: (-0.3, -0.6, -1); power: 0.6; }
Scene { duration: 2.5s; background: #0d1117; }
