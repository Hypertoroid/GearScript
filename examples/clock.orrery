@orrery 1

@scene
// The hour hand is coupled to the minute hand at 1/12.
Face::Disc      { radius: 120mm; thickness: 8mm; at: (0, 0, 0); }
MinuteHub::Disc { radius: 7mm;  thickness: 3mm; at: Face.face.front + (0, 0, 5mm); }
HourHub::Disc   { radius: 10mm; thickness: 3mm; at: Face.face.front + (0, 0, 1.5mm); couple: MinuteHub 1/12; }

Hour::Box   { size: (8mm, 60mm, 2mm); attach: face.bottom to HourHub.face.front; }
Minute::Box { size: (5mm, 96mm, 2mm); attach: face.bottom to MinuteHub.face.front; }

// sounds: generated by Orrery, free to use
Tick::Sound { kind: tick; }
Tock::Sound { kind: tock; }

Observer { position: (0, -60mm, 430mm); look-at: (0, 0, 0); }
Light { kind: directional; direction: (-0.3, -0.6, -1); power: 0.9; }
Scene { duration: 12s; }

@style
Face             { color: #f3efe6; material: matte; outline: 1px #8a8378; }
HourHub, Hour    { color: graphite; }
MinuteHub        { color: #b8442e; }
Minute           { color: #b8442e; label: "minute"; }
Hour             { label: "hour"; }

@motion
// One turn of the minute hand every 12 s.
MinuteHub {
    forever: rotate: -30deg/s;
}

MinuteHub { 0s..12s: sound: Tick every 2s; 1s..12s: sound: Tock every 2s; }
