@orrery 1

@scene
// A flat net folds into a box. Each flap hinges on an edge of the one before it.
Base::Box       { size: (200mm, 4mm, 200mm); at: (0, 2mm, 0); }
Right::Box.flap { size: (200mm, 4mm, 200mm); hinge: edge.left-top on Base.edge.right-top; }
Left::Box.flap  { size: (200mm, 4mm, 200mm); hinge: edge.right-top on Base.edge.left-top; }
Front::Box.flap { size: (200mm, 4mm, 200mm); hinge: edge.back-top on Base.edge.front-top; }
Back::Box.flap  { size: (200mm, 4mm, 200mm); hinge: edge.front-top on Base.edge.back-top; }
Lid::Box.flap   { size: (200mm, 4mm, 200mm); hinge: edge.front-top on Back.edge.back-top; }   // rides on Back

// sounds: generated by Orrery, free to use
Flap::Sound { kind: knock; pitch: 70%; volume: 60%; }

Observer { position: (520mm, 520mm, 640mm); look-at: (0, 60mm, -60mm); }
Light { kind: directional; direction: (-0.6, -1, -0.4); power: 0.85; }
Scene { grid: floor; duration: 4s; }

@style
Box  { color: #c9a26b; material: matte; outline: 1px #6e5130; }
Base { color: #b58d57; }
Lid  { color: #d8b680; }

@motion
Right { 0s..1s: rotate: 0deg -> 90deg ease-in-out; }
Left  { 0s..1s: rotate: 0deg -> -90deg ease-in-out; }
Front { 1s..2s: rotate: 0deg -> -90deg ease-in-out; }
Back  { 1s..2s: rotate: 0deg -> 90deg ease-in-out; }
Lid   { 2s..3s: rotate: 0deg -> 90deg ease-in-out; }

// a soft knock as each flap lands
Right { 0s..1s: sound: Flap at end; }
Front { 1s..2s: sound: Flap at end; }
Lid   { 2s..3s: sound: Flap at end; }
