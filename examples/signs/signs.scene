// Text and sky: a gear train explained with words that live in the scene.
// Face text prints on the parts; Text parts are words you can place, fade and turn to the viewer.
Board::Plate    { size: (520mm, 260mm); thickness: 14mm; corner: 18mm; at: (0, 0, -40mm); }
Driver::Gear    { teeth: 36; module: 4mm; width: 16mm; at: (-110mm, 0, 0); }
Idler::Gear     { teeth: 18; module: 4mm; width: 16mm; mesh: Driver; }
Output::Gear    { teeth: 12; module: 4mm; width: 16mm; mesh: Idler at 0deg; }
Title::Text     { text: "Gear ratio 3 : 1"; size: 34mm; at: (0, 230mm, 0); facing: camera; }
Step1::Text     { text: "A motor turns the 36-tooth driver"; size: 15mm; at: (0, -190mm, 30mm); facing: camera; }
Step2::Text     { text: "The idler only changes direction"; size: 15mm; at: (0, -190mm, 30mm); facing: camera; }
Step3::Text     { text: "12 teeth: the output turns 3 times as fast"; size: 15mm; at: (0, -190mm, 30mm); facing: camera; }
Plaque::Text    { text: "MODEL 3-1\nmodule 4 mm"; size: 15mm; at: (170mm, -86mm, -32mm); }   // printed on the board
Brand::Text     { text: "GEARSCRIPT"; size: 26mm; at: (150mm, 84mm, -30mm); }   // solid letters standing on the board

Observer { position: (240mm, 120mm, 900mm); look-at: (0, 20mm, 0); fov: 36deg; }
Light    { kind: directional; direction: (-0.4, -0.8, -1); power: 0.75; }
Scene    { duration: 12s; sky: dusk; ground: #2b2f35; }
