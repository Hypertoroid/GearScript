@gearscript 1

@scene
// A windscreen wiper. A motor crank drives a four-bar linkage and the arm is fixed to the
// rocker, so each full turn of the motor becomes one sweep there and back.
define Bar(len) :: Link { length: len; width: 10mm; }

Screen::Box { size: (520mm, 260mm, 4mm); at: (0, 110mm, -30mm); }
Motor::Cylinder { radius: 18mm; height: 20mm; orient: 90deg about x; at: (-150mm, -70mm, -12mm); }

Crank::Bar(30mm)  { hinge: end.a on (-150mm, -70mm, 0); }
Drive::Bar(152mm) { hinge: end.a on Crank.end.b + (0, 0, 5mm); pin: end.b to Lever.end.b; }
Lever::Bar(40mm)  { orient: -90deg about z; hinge: end.a on (0, -20mm, 0); }
Arm::Rod   { length: 210mm; radius: 3mm; attach: end.a to Lever.end.a + (0, 0, 12mm); }
Blade::Box { size: (12mm, 150mm, 8mm); attach: face.top to Arm.end.b + (0, 0, 6mm); }

// sounds: generated by GearScript, free to use
Squeak::Sound { kind: squeak; length: 0.8s; volume: 45%; }

Observer { position: (0, 60mm, 820mm); look-at: (0, 70mm, 0); }
Light { kind: directional; direction: (-0.3, -0.6, -1); power: 0.85; }
Scene { duration: 4s; }

@style
Screen { color: #a9d4e0; material: glass; }
Motor  { color: #3b4148; }
Bar    { color: #6b7580; material: plastic; }
Crank  { color: #e0a63a; label: "motor crank"; }
Arm    { color: graphite; }
Blade  { color: #b8442e; trail: face.top 1s #2f6f8f; }

@motion
Crank { forever: rotate: 180deg/s; }

// one squeak per sweep: the crank turns once in 2 s, the blade sweeps twice
Crank { forever: sound: Squeak every 1s; }
