TagMarks { 0s..61.2s: opacity: 0; 61.2s..61.65s: opacity: 0 -> 1; 63.8s..64.4s: opacity: 1 -> 0; }

Cannon {
    0s..64.4s: move: (0, 0, 120mm); opacity: 0;
    64.4s..65.4s: move: (0, 0, 120mm) -> (0, 0, 0) ease-out;
    64.4s..65s: opacity: 0 -> 1;
    64.4s..65.02s: sound: Click at end;
}

HourHand {
    0s..66.2s: move: (0, 0, 160mm); opacity: 0;
    66.2s..67.8s: move: (0, 0, 160mm) -> (0, 0, 0) ease-out;
    66.2s..66.8s: opacity: 0 -> 1;
    0s..95.5s: rotate: 55deg about z;
    95.5s..110s: rotate: 55deg + -0.375deg * (floor(t - 95.5) + min(1, (t - 95.5 - floor(t - 95.5)) * 6)) about z;
    66.2s..67.19s: sound: Snap at end;
    66.2s..67.8s: sound: Whoosh;
}

MinuteHand {
    0s..69.2s: move: (0, 0, 160mm); opacity: 0;
    69.2s..70.8s: move: (0, 0, 160mm) -> (0, 0, 0) ease-out;
    69.2s..69.8s: opacity: 0 -> 1;
    0s..95.5s: rotate: -60deg about z;
    95.5s..110s: rotate: -60deg + -4.5deg * (floor(t - 95.5) + min(1, (t - 95.5 - floor(t - 95.5)) * 6)) about z;
    69.2s..70.19s: sound: Snap at end;
    69.2s..70.8s: sound: Whoosh;
}

TagHour { 0s..67.2s: opacity: 0; 67.2s..67.65s: opacity: 0 -> 1; 70s..70.6s: opacity: 1 -> 0; }

TagMinute { 0s..70.2s: opacity: 0; 70.2s..70.65s: opacity: 0 -> 1; 73.2s..73.8s: opacity: 1 -> 0; }

Pendulum {
    0s..75.6s: move: (-900mm, 0, 0); opacity: 0;
    75.6s..78.6s: move: (-900mm, 0, 0) -> (0, 0, 0) ease-out;
    75.6s..76.4s: opacity: 0 -> 1;
    96s..110s: rotate: 6deg * sin((t - 96) * 3.1416) about z;
    95.5s..110s: sound: Tick every 2s;      // tick at one end of the swing,
    96.5s..110s: sound: Tock every 2s;      // tock at the other
    75.6s..77.46s: sound: Thud at end;
    75.6s..78.6s: sound: Whoosh;
}

TagPendulum { 0s..78s: opacity: 0; 78s..78.45s: opacity: 0 -> 1; 82s..82.6s: opacity: 1 -> 0; }

