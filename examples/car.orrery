@orrery 1

@scene
// A car built only from library shapes. No car primitive.
let wheel = 55mm;

Car::Group.paint {
    chassis: Box { size: (440mm, 50mm, 180mm); }
    cabin:   Box { size: (230mm, 80mm, 168mm); align: face.bottom; at: chassis.face.top + (-25mm, 0, 0); }
    glass:   Box { size: (234mm, 46mm, 172mm); at: cabin.center + (0, 10mm, 0); }
    hood:    Box { size: (120mm, 14mm, 176mm); align: face.bottom; at: chassis.face.top + (150mm, 0, 0); }
    bumper:  Box { size: (12mm, 18mm, 186mm); at: chassis.face.right + (4mm, -18mm, 0); }
    lamp:    Sphere.lamp { radius: 12mm; repeat: 2; at: chassis.face.right + (0, 6mm, 58mm - i * 116mm); }
    tail:    Box.tail { size: (6mm, 14mm, 30mm); align: face.right; repeat: 2; at: chassis.face.left + (0, 8mm, 62mm - i * 124mm); }
    axle:    Rod { length: 230mm; radius: 6mm; orient: 90deg about x; repeat: 2; at: chassis.face.bottom + (140mm - i * 280mm, 10mm, 0); }
    at: (0, 74mm, 0);
}

// A reusable part type: one line per wheel. The hinge rides on the car.
define Tyre(mount) :: Wheel { radius: wheel; width: 34mm; hinge: axis on mount; }
FL::Tyre(Car.axle1.end.b);
FR::Tyre(Car.axle1.end.a);
RL::Tyre(Car.axle2.end.b);
RR::Tyre(Car.axle2.end.a);

Road::Group {
    surface: Box { size: (6000mm, 4mm, 700mm); }
    dash: Box.dash { size: (220mm, 2mm, 18mm); at: surface.face.top + (-2500mm, 1mm, 0); repeat: 11 step (500mm, 0, 0); }
    at: (1500mm, 2mm, -60mm);
}

// sounds: generated by Orrery, free to use
Motor::Sound { kind: whirr; pitch: 70%; length: 4.2s; volume: 40%; }
Brake::Sound { kind: squeak; pitch: 85%; length: 1s; volume: 35%; }

Observer { position: (380mm, 330mm, 1150mm); }
Light { kind: directional; direction: (-0.5, -1, -0.6); power: 0.9; }
Scene { duration: 5s; }

@style
.paint      { color: #2f6f8f; material: plastic; outline: 1px #13303d; }
Car.glass   { color: #a9d4e0; material: glass; }
.lamp       { color: #fff4c2; material: plastic; }
.tail       { color: #d23b2e; }
Car.bumper  { color: graphite; }
Rod         { color: graphite; material: metal; }
Tyre        { color: gradient(#16181b, #5d6670, axis: x); material: matte; }
Road        { color: #3b4148; material: matte; }
.dash       { color: #f2efe6; }

@motion
// A change between two speeds is an acceleration. Units decide: mm/s is a speed.
let cruise = (600mm/s, 0, 0);

Car {
    0s..1.5s: move: (0, 0, 0) -> cruise ease-in;     // pull away
    then:     move: cruise;                          // cruise for 1.5 s
    3s..4.2s: move: cruise -> (0, 0, 0) ease-out;    // brake to a stop
}

// Every Tyre rolls: the spin always matches the car, even while it speeds up and slows down.
Tyre { forever: roll: Road; }

Observer { forever: follow: Car offset (380mm, 260mm, 1150mm); }

Scene { sound: Motor; }
Car { 3s..4.2s: sound: Brake; }
