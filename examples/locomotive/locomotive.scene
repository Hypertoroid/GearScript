// A steam locomotive, built only from library shapes.
// Nothing here is animated by hand except the train's speed: the wheels roll, the coupling rod and
// main rod are solved as closed loops, and the crosshead slides wherever the main rod pushes it.
let r = 45mm;                    // driving wheel radius
let pitch = 100mm;               // axle spacing

Loco::Group.engine {
    frame:     Box { size: (400mm, 24mm, 96mm); at: (40mm, 30mm, 0); }
    footplate: Box { size: (450mm, 6mm, 156mm); at: (45mm, 55mm, 0); }
    boiler:    Cylinder { radius: 48mm; height: 300mm; orient: 90deg about z; at: (95mm, 108mm, 0); }
    band:      Cylinder.trim { radius: 49mm; height: 6mm; orient: 90deg about z; repeat: 3; at: (0mm + i * 90mm, 108mm, 0); }
    smokebox:  Cylinder.dark { radius: 52mm; height: 50mm; orient: 90deg about z; at: (268mm, 108mm, 0); }
    chimney:   Cylinder.dark { radius: 13mm; height: 50mm; at: (262mm, 176mm, 0); }
    dome:      Sphere { radius: 22mm; at: (120mm, 152mm, 0); }
    cab:       Box { size: (110mm, 135mm, 156mm); at: (-122mm, 122mm, 0); }
    window:    Box.dark { size: (40mm, 36mm, 158mm); at: (-112mm, 150mm, 0); }
    roof:      Box.dark { size: (134mm, 8mm, 170mm); at: (-122mm, 193mm, 0); }
    beam:      Box.red { size: (10mm, 32mm, 156mm); at: (270mm, 44mm, 0); }
    lamp:      Sphere { radius: 9mm; at: (296mm, 148mm, 0); }
    axle:      Rod { length: 132mm; radius: 5mm; orient: 90deg about x; repeat: 3; at: (-60mm + i * pitch, 0, 0); }
    cyl:       Cylinder.dark { radius: 20mm; height: 70mm; orient: 90deg about z; at: (252mm, 0, 84mm); }
    guide:     Rod { length: 72mm; radius: 2.5mm; orient: 90deg about z; at: (182mm, 13mm, 84mm); }
    anchor view: (60mm, 110mm, 0);           // where the camera looks
    at: (0, r, 0);
}

// Driving wheels: one line each. The crank anchor is where the rods attach.
define Driver(mount) :: Wheel { radius: r; width: 10mm; hinge: axis on mount; anchor crank: (0, -24mm, 0); }
D1::Driver(Loco.axle1.end.b);
D2::Driver(Loco.axle2.end.b);
D3::Driver(Loco.axle3.end.b);
D4::Driver(Loco.axle1.end.a);
D5::Driver(Loco.axle2.end.a);
D6::Driver(Loco.axle3.end.a);

// Valve gear. Two closed loops: the coupling rod joins all three cranks,
// and the main rod joins the middle crank to a crosshead on a slider.
Side::Link  { length: 200mm; width: 10mm; thickness: 4mm; hinge: end.a on D1.crank + (0, 0, 9mm);
              pin: end.b to D3.crank;  pin: mid to D2.crank; }
Main::Link  { length: 140mm; width: 12mm; thickness: 4mm; hinge: end.a on D2.crank + (0, 0, 15mm);
              pin: end.b to Cross.center; }
Cross::Box  { size: (14mm, 22mm, 12mm); orient: -90deg about z; slider: axis on Loco.guide.axis; }
PistonRod::Rod { length: 80mm; radius: 3mm; orient: -90deg about z; attach: end.a to Cross.center; }

// The tender rides behind, fused to the cab.
Tender::Group.engine {
    tank:  Box { size: (210mm, 110mm, 156mm); }
    coal:  Box.dark { size: (150mm, 20mm, 120mm); align: face.bottom; at: tank.face.top + (-15mm, 0, 0); }
    frame: Box.red { size: (220mm, 20mm, 96mm); align: face.top; at: tank.face.bottom; }
    axle:  Rod { length: 132mm; radius: 4mm; orient: 90deg about x; repeat: 2; at: (-55mm + i * 110mm, -103mm, 0); }
    attach: tank.face.right to Loco.cab.face.left + (-16mm, -30mm, 0);
}
define Small(mount) :: Wheel { radius: 32mm; width: 8mm; hinge: axis on mount; }
T1::Small(Tender.axle1.end.b);
T2::Small(Tender.axle2.end.b);
T3::Small(Tender.axle1.end.a);
T4::Small(Tender.axle2.end.a);

// The line: rails, sleepers, and a semaphore signal that clears as the train approaches.
Track::Group {
    railN:   Box.rail { size: (5000mm, 8mm, 6mm); at: (2100mm, -4mm, 65mm); }
    railS:   Box.rail { size: (5000mm, 8mm, 6mm); at: (2100mm, -4mm, -65mm); }
    sleeper: Box.sleeper { size: (16mm, 6mm, 190mm); repeat: 50; at: (-350mm + i * 100mm, -11mm, 0); }
}
Ground::Box { size: (5600mm, 4mm, 1400mm); at: (2100mm, -16mm, 0); }
Post::Box   { size: (12mm, 340mm, 12mm); at: (3250mm, 156mm, -190mm); }
Arm::Link   { length: 90mm; width: 16mm; thickness: 4mm; orient: 180deg about z; hinge: end.a on (3256mm, 300mm, -182mm); }

// sounds: generated by Orrery, free to use
Chuff::Sound  { kind: chug; volume: 80%; }
Steam::Sound  { kind: hiss; length: 1.4s; volume: 50%; }
Signal::Sound { kind: clang; pitch: 140%; volume: 45%; }

Observer { position: (260mm, 200mm, 900mm); }
Light { kind: directional; direction: (-0.4, -1, -0.7); power: 0.9; }
Scene { duration: 10s; background: #cfe0ea; }
