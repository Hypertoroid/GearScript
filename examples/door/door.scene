// A door on a frame: one hinge, one motion rule.
Frame::Box { size: (60mm, 2000mm, 60mm); at: (0, 1000mm, 0); }

Door::Group.wooden {
    panel: Box    { size: (800mm, 2000mm, 40mm); }
    knob:  Sphere { radius: 30mm; at: panel.face.front + (320mm, 0, 25mm); }
    hinge: panel.edge.left on Frame.edge.right;
    range: 0deg..110deg;
}

// sounds: generated by Orrery, free to use
Creak::Sound { kind: creak; length: 1.8s; volume: 60%; }
Shut::Sound  { kind: latch; }

Observer { position: (2600mm, 1700mm, 3400mm); look-at: (450mm, 1000mm, 0); }
Light { kind: directional; direction: (-1, -2, -1.5); power: 0.85; }
Scene { grid: floor; duration: 4.5s; }
