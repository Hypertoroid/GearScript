{
 "language": 1,
 "studio": "1.0.0-beta",
 "versionLine": "@orrery 1",
 "sections": [
  "scene",
  "style",
  "motion"
 ],
 "fileExtension": ".orrery",
 "syntax": {
  "part": "Name::Type.class { prop: value; }",
  "group": "Name::Group { member: Type { ... } }",
  "define": "define Name(param, other = 10mm) :: Type { ... }",
  "let": "let name = value;",
  "comment": "// line  or  /* block */",
  "styleRule": "Selector, .class, #Name { prop: value; }",
  "motionRule": "Target { forever: prop: value;  0s..2s: prop: a -> b ease-in-out;  then 2s: ... }"
 },
 "units": {
  "mm": "length",
  "cm": "length",
  "m": "length",
  "deg": "angle",
  "rad": "angle",
  "turn": "angle",
  "s": "time",
  "ms": "time",
  "mm/s": "speed",
  "deg/s": "spin rate",
  "turn/s": "spin rate",
  "mm/s2": "acceleration",
  "m/s2": "acceleration",
  "deg/s2": "angular acceleration",
  "%": "fraction"
 },
 "easings": [
  "linear",
  "ease",
  "ease-in",
  "ease-out",
  "ease-in-out",
  "cubic-bezier(0.4, 0, 0.2, 1)"
 ],
