@gearscript 1

@scene
// A lighthouse at dusk: the lamp turns, its beam sweeps the sea, and the windows light up one by one.
Sea::Cylinder     { radius: 900mm; height: 6mm; at: (0, -3mm, 0); }
Rock::Cylinder    { radius: 150mm; height: 60mm; at: (0, 30mm, 0); }
Tower::Cylinder   { radius: 70mm; height: 420mm; at: (0, 270mm, 0); }
Band1::Cylinder   { radius: 72mm; height: 40mm; at: (0, 200mm, 0); }
Band2::Cylinder   { radius: 72mm; height: 40mm; at: (0, 360mm, 0); }
Gallery::Cylinder { radius: 95mm; height: 12mm; at: (0, 486mm, 0); }
Room::Cylinder    { radius: 58mm; height: 80mm; at: (0, 532mm, 0); overlap: allow; }
Roof::Cone        { radius: 75mm; height: 60mm; at: (0, 602mm, 0); }
Head::Group {
  lamp: Sphere { radius: 22mm; at: (0, 0, 0); }
  beam: Cone   { radius: 80mm; height: 900mm; orient: 90deg about z; at: (450mm, 0, 0); }   // the tip sits on the lamp
  at: (0, 532mm, 0); overlap: allow;
}
W1::Box.window { size: (16mm, 26mm, 4mm); at: (0, 140mm, 70mm); }
W2::Box.window { size: (16mm, 26mm, 4mm); at: (0, 280mm, 70mm); }
W3::Box.window { size: (16mm, 26mm, 4mm); at: (0, 420mm, 70mm); }
Moon::Sphere      { radius: 40mm; at: (-900mm, 900mm, -1400mm); }

Observer { position: (760mm, 520mm, 980mm); look-at: (0, 300mm, 0); }
Light { kind: directional; direction: (-0.3, -1, -0.5); power: 0.2; }    // dusk: little daylight left
Scene { duration: 12s; background: #0d1626; }

@style
Sea        { color: #1d3a5c; metalness: 0.1; roughness: 0.5; }
Rock       { color: #4a4f57; roughness: 0.95; }
Tower      { color: #e8e4dc; }
Band1, Band2 { color: #b8442e; }
Gallery, Roof { color: #2b3138; metalness: 0.8; roughness: 0.4; }
Room       { color: #9fc4e8; material: glass; }
Head.lamp  { color: #fff1c4; luminosity: 120% 1400mm; }            // a strong light that reaches the sea
Head.beam  { color: rgba(255, 200, 90, 0.45); luminosity: 100%; shadow: none; }   // see-through and luminous: it adds light like a real beam
.window    { color: #2a2f38; luminosity: 0 #ffd27a 160mm; }   // dark until the motion turns it up; it lights only the wall nearby
Moon       { color: #dfe6f0; luminosity: 45% 2400mm; }

@motion
Head { forever: rotate: 30deg/s about y; }   // one turn in the 12 s loop
// the keeper climbs the stairs: each window warms up as a light goes on
W1 { 1s..2s: color: #2a2f38 -> #ffd27a; luminosity: 0 -> 60%; }
W2 { 3s..4s: color: #2a2f38 -> #ffd27a; luminosity: 0 -> 60%; }
W3 { 5s..6s: color: #2a2f38 -> #ffd27a; luminosity: 0 -> 60%; }
