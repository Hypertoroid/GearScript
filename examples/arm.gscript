@gearscript 1

@scene
// A two-link arm on a turntable. Each hinge rides on the part below it.
Base::Cylinder { radius: 90mm; height: 40mm; at: (0, 20mm, 0); }
Tower::Box     { size: (70mm, 120mm, 80mm); attach: face.bottom to Base.face.top; }

Upper::Box { size: (40mm, 260mm, 50mm); hinge: edge.bottom on Tower.edge.top; range: -80deg..80deg; }
Fore::Box  { size: (34mm, 220mm, 44mm); hinge: edge.bottom on Upper.edge.top; range: -140deg..140deg; }
Hand::Box  { size: (70mm, 24mm, 54mm);  attach: face.bottom to Fore.face.top; }

// sounds: generated by GearScript, free to use
Servo::Sound { kind: servo; length: 2s; volume: 35%; }

Observer { position: (760mm, 560mm, 960mm); look-at: (0, 280mm, 0); }
Light { kind: directional; direction: (-1, -1.5, -0.7); power: 0.85; }
Scene { grid: floor; duration: 6s; }

@style
Base, Tower   { color: graphite; material: metal; }
Upper, Fore   { color: #e0a63a; material: plastic; outline: 1px #5a3f0c; }
Hand          { color: #b8442e; material: plastic; }

@motion
Base {
    forever: rotate: 60deg/s;
}
Upper {
    0s..2s: rotate: 0deg -> 35deg ease-in-out;
    3s..5s: rotate: 35deg -> 0deg ease-in-out;
}
Fore {
    0.5s..2.5s: rotate: 0deg -> 80deg ease-in-out;
    3.5s..5.5s: rotate: 80deg -> 0deg ease-in-out;
}

Upper { 0s..2s: sound: Servo; 3s..5s: sound: Servo; }
Fore  { 0.5s..2.5s: sound: Servo 70%; 3.5s..5.5s: sound: Servo 70%; }
