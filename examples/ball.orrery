@orrery 1

@scene
// Your first sketch, in the current syntax.
Ball::Sphere { radius: 50mm; at: (0, 0, 0); }
Observer     { position: (1000mm, 0, 0); zoom: 3; }
Light        { power: 0.44; }
Scene        { grid: floor; duration: 14s; }

@style
Ball { color: gradient(#ff6a00, #ee0979, axis: x); }

@motion
Ball {
    forever: rotate: 45deg/s;
             move: (0, 100mm/s, 0);
             x: 0;
}

Observer {
    0s..10s: follow: Ball offset (1000mm, 0, 0);
    then:    y: 0;
}
