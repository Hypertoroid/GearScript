// An eagle circles its prey, and so does the camera: it rides just behind the eagle.
Ground::Box { size: (1800mm, 4mm, 1800mm); at: (0, -2mm, 0); overlap: allow; }   // the rocks sit half sunk in it

// Trees and rocks placed in a ring with repeat; i counts 0, 1, 2 ...
Trunk::Cylinder.trunk { radius: 9mm; height: 70mm; repeat: 7; at: (680mm * cos(i * 0.9 + 0.3), 35mm, 620mm * sin(i * 0.9 + 0.3)); }
Crown::Cone.crown     { radius: 40mm; height: 110mm; repeat: 7; at: (680mm * cos(i * 0.9 + 0.3), 125mm, 620mm * sin(i * 0.9 + 0.3)); }
Rock::Sphere.rock     { radius: 16mm; repeat: 9; at: (460mm * cos(i * 0.7), 4mm, 380mm * sin(i * 0.7)); }

// The prey runs a figure-eight. One let describes the shape; two curves use it.
let eightX = 260mm * sin(6.283 * u);
let eightZ = 160mm * sin(12.566 * u);
Trail::Curve { domain: u in 0..1; point: (eightX, 3mm, eightZ); stroke: 2mm; }
Run::Curve   { domain: u in 0..1; point: (eightX, 20mm, eightZ); visible: false; }
Mouse::Group {
    body:  Sphere { radius: 20mm; }
    head:  Sphere { radius: 12mm; at: body.center + (22mm, 6mm, 0); }
    earL:  Sphere.ear { radius: 6mm; at: head.center + (0, 10mm, 7mm); }
    earR:  Sphere.ear { radius: 6mm; at: head.center + (0, 10mm, -7mm); }
    tail:  Rod { length: 40mm; radius: 1.5mm; orient: 70deg about z; at: body.center + (-34mm, -4mm, 0); }
    at: (0, 20mm, 0);
}

// The eagle: a body group, and two wings on hinges along its sides.
Eagle::Group {
    body:  Box { size: (30mm, 24mm, 100mm); }
    head:  Sphere { radius: 14mm; at: body.face.back + (0, 6mm, -6mm); }
    beak:  Cone { radius: 5mm; height: 16mm; orient: -90deg about x; at: head.center + (0, -2mm, -16mm); }
    tail:  Box { size: (44mm, 4mm, 40mm); at: body.face.front + (0, 0, 16mm); }
    at: (320mm, 440mm, 0);
}
WingL::Box.wing { size: (170mm, 4mm, 60mm); hinge: edge.right on Eagle.body.edge.left; }
WingR::Box.wing { size: (170mm, 4mm, 60mm); hinge: edge.left on Eagle.body.edge.right; }

Observer { position: (800mm, 1100mm, 260mm); }
Light { kind: directional; direction: (-0.6, -0.7, -0.5); power: 0.45; }
Scene { duration: 12s; background: #dfe9ee; }
