@orrery 1

@scene
// A single-cylinder engine: a slider-crank. Only the flywheel turns.
// The connecting rod's pin keeps it on the piston, so the piston works out its own position.
Flywheel::Disc { radius: 70mm; thickness: 10mm; at: (0, 0, -20mm); }
Weight::Box    { size: (60mm, 26mm, 10mm); attach: Flywheel.face.front + (0, -40mm, 5mm); }
Crank::Link    { length: 40mm; width: 20mm; orient: 90deg about z; attach: end.a to Flywheel.face.front + (0, 0, 10mm); }

Bore::Cylinder   { radius: 34mm; height: 180mm; at: (0, 180mm, 0); }
Piston::Cylinder { radius: 31mm; height: 44mm; slider: axis on Bore.axis; }
Rod::Link        { length: 150mm; width: 16mm; orient: 90deg about z; hinge: end.a on Crank.end.b + (0, 0, 8mm); pin: end.b to Piston.center; }

// sounds: generated by Orrery, free to use
Putt::Sound { kind: chug; pitch: 70%; }

Observer { position: (120mm, 150mm, 640mm); look-at: (0, 110mm, 0); }
Light { kind: directional; direction: (-0.5, -0.7, -1); power: 0.85; }
Scene { duration: 3s; }

@style
Flywheel { color: gradient(#3b4148, #8f99a3, axis: x); material: metal; }
Weight   { color: #3b4148; }
Crank    { color: #b8442e; }
Rod      { color: steel; material: metal; trail: mid #e0a63a; }
Piston   { color: #c7ccd2; material: metal; }
Bore     { color: glass; material: glass; outline: 1px #5d8a96; }

@motion
Flywheel { forever: rotate: 240deg/s; }

// one firing every turn of the flywheel (240deg/s: one turn per 1.5 s)
Flywheel { forever: sound: Putt every 1.5s; }
